# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente local.
# NUNCA faca commit do arquivo ".env" real (ele ja esta no .gitignore).

# ---- Banco de dados (PostgreSQL) ----
DATABASE_URL=jdbc:postgresql://localhost:5432/chatbot_db
DATABASE_USERNAME=chatbot
DATABASE_PASSWORD=chatbot

# ---- Aplicacao ----
SERVER_PORT=8080
APP_LOG_LEVEL=INFO
JPA_SHOW_SQL=false

# ---- Integracao com WhatsApp (Meta Cloud API) ----
# Com WHATSAPP_ENABLED=false (padrao) o sistema roda inteiro sem credenciais:
# as respostas sao apenas logadas pelo MockWhatsAppSender e o simulador em
# /simulator continua funcionando. Coloque true somente depois de preencher o
# token, o phone number ID e o App Secret abaixo.
# Passo a passo de onde obter cada valor: README, secao "Integracao real com WhatsApp".
WHATSAPP_ENABLED=false

# URL base e versao da Graph API. Os padroes servem para a Cloud API oficial.
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0

# Token de acesso da Cloud API (Meta > WhatsApp > API Setup).
# O token temporario expira em 24h; use um token de System User para uso continuo.
WHATSAPP_ACCESS_TOKEN=

# ID do numero remetente (Meta > WhatsApp > API Setup > "Phone number ID").
# Atencao: NAO e o numero de telefone, e um id numerico.
WHATSAPP_PHONE_NUMBER_ID=

# Token que VOCE inventa e repete no painel da Meta ao cadastrar o webhook.
# Usado apenas no handshake GET de verificacao da URL.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# App Secret do app da Meta (Meta > App settings > Basic > App secret).
# Valida a assinatura X-Hub-Signature-256 de cada notificacao recebida: sem ele,
# qualquer pessoa que descubra a URL publica pode injetar mensagens falsas.
# Obrigatorio em producao.
WHATSAPP_APP_SECRET=

# ---- Inteligencia artificial (opcional) ----
# Quando desabilitada ou indisponivel, o chatbot usa as respostas locais.
AI_ENABLED=false
AI_API_URL=https://api.openai.com/v1/responses
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=10
AI_MAX_OUTPUT_TOKENS=300

# ---- Ciclo de vida das conversas ----
# A rotina nao encerra conversas aguardando ou em atendimento humano.
CONVERSATION_AUTO_CLOSE_ENABLED=true
CONVERSATION_INACTIVITY_HOURS=24
CONVERSATION_CHECK_INTERVAL_MS=300000

# ---- Usadas apenas pelo docker-compose (banco dentro do container) ----
POSTGRES_DB=chatbot_db
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
